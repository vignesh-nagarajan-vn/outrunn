// Copy this file to Secrets.xcconfig (gitignored) and fill in real values.

// Presage SmartSpectra key. The SDK needs it on the device.
SMARTSPECTRA_API_KEY = PASTE_SMARTSPECTRA_API_KEY

// Where web/ is deployed. xcconfig treats // as a comment, so keep the $() in the URL.
COACH_BASE_URL = https:/$()/outrunn.vercel.app
